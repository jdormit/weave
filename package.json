{
  "name": "weave",
  "version": "0.1.0",
  "private": true,
  "description": "Open source Loom alternative: record, transcribe locally, and edit by transcript.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "preview": "bun run scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "e2e": "playwright test",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@effect/atom-react": "4.1.2",
    "@effect/platform-browser": "4.1.2",
    "@fontsource-variable/inter": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "effect": "4.1.2",
    "mediabunny": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scheduler": "0.27.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "4.157.0"
  }
}
